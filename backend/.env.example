# Core application
ENVIRONMENT=development
STRICT_SECRET_VALIDATION=False
APP_NAME=CropGear
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Database
MONGODB_URL=mongodb://admin:password@localhost:27017/cropgear_db?authSource=admin
DATABASE_NAME=cropgear_db
USE_MOCK_DB=False

# JWT & security
SECRET_KEY=your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS / hosts
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://localhost:5175"]
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
ALLOWED_HOSTS=["localhost","127.0.0.1","0.0.0.0","::1","testserver"]

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@cropgear.com
ENABLE_EMAIL_VERIFICATION=True
ENABLE_BOOKING_CONFIRMATION_EMAIL=True
ENABLE_BOOKING_REQUEST_EMAIL=True
ENABLE_BOOKING_STATUS_EMAIL=True
ENABLE_PAYMENT_RECEIPT_EMAIL=True
ENABLE_NEWSLETTER_WELCOME_EMAIL=True
ENABLE_ADMIN_APPROVAL_EMAIL=True
ENABLE_OWNER_VERIFICATION_EMAIL=True
ENABLE_PASSWORD_RESET_EMAIL=True
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173

# Media / AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=cropgear-images

# Payments
STRIPE_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Search / location
GOOGLE_MAPS_API_KEY=
ENABLE_LOCATION_SEARCH=True

# Optional infrastructure
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Demo data
ENABLE_DEMO_SEED=True
